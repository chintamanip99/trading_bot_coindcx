def is_valid_new_position(position_type, entry_price):
    with position_lock:
        for position in active_positions:
            if not position.exited and (position.position_type == position_type and
                abs(entry_price - position.entry_price) < min_price_distance):
                return False
        return True

def check_positions(current_price):
    global active_positions, current_balance, total_fees, total_pnl, order_status, trade_log_global, last_trade_time, closed_positions_list

    current_price = float(current_price)
    positions_to_remove = []

    with position_lock:
        active_positions = [p for p in active_positions if not p.exited]

        for position in active_positions:
            logging.info(f"Checking position {position.id}: type={position.position_type}, "
                        f"entry={position.entry_price}, current={current_price}, "
                        f"target={position.target}, stop_loss={position.stop_loss}, "
                        f"order_filled={position.order_filled}")

            if not position.order_filled:
                if (datetime.datetime.now() - position.entry_time) > timedelta(seconds=30):
                    logging.warning(f"Order for position {position.id} taking too long, assuming filled")
                    position.order_filled = True
                else:
                    continue

            exit_reason = None
            exit_price = current_price

            if position.position_type == "long":
                if current_price >= position.target:
                    exit_reason = "target"
                    exit_price = position.target
                elif current_price <= position.stop_loss:
                    exit_reason = "stop loss"
                    exit_price = position.stop_loss
            else:
                if current_price <= position.target:
                    exit_reason = "target"
                    exit_price = position.target
                elif current_price >= position.stop_loss:
                    exit_reason = "stop loss"
                    exit_price = position.stop_loss

            if not exit_reason and (datetime.datetime.now() - position.entry_time) > timedelta(minutes=240):
                exit_reason = "time limit"

            if exit_reason:
                # PnL on the position
                if position.position_type == "long":
                    profit_loss = (exit_price - position.entry_price) * position.shares
                else:
                    profit_loss = (position.entry_price - exit_price) * position.shares

                position.exit_fee = exit_price * position.shares * (
                    TAKER_FEE if exit_reason in ["stop loss", "time limit"] else MAKER_FEE
                )

                net_pnl = profit_loss - position.entry_fee - position.exit_fee
                position.pnl = net_pnl

                # FIXED: Return position value + net PnL to balance
                # (position_value + entry_fee were removed at open)
                current_balance += position.position_value
                current_balance += net_pnl
                total_fees += position.exit_fee
                total_pnl += net_pnl

                position.exited = True
                position.exit_time = datetime.datetime.now()
                position.exit_reason = exit_reason
                last_trade_time = datetime.datetime.now()

                closed_position_data = {
                    'id': position.id,
                    'type': position.position_type,
                    'entry_price': position.entry_price,
                    'exit_price': exit_price,
                    'shares': position.shares,
                    'entry_time': position.entry_time,
                    'exit_time': position.exit_time,
                    'pnl': net_pnl,
                    'fees': position.entry_fee + position.exit_fee,
                    'exit_reason': exit_reason
                }
                closed_positions_list.append(closed_position_data)

                if REAL_TRADING_MODE:
                    order_type = "sell" if position.position_type == "long" else "buy"
                    place_order(order_type, exit_price, position.shares)
                else:
                    logging.info(f"PAPER TRADE: Exit {position.position_type} at {exit_price}")

                curr_balance = current_balance

                trade_log = (
                    f"EXIT {position.position_type.upper()} ({exit_reason}): "
                    f"Entry: {position.entry_price:.8f} | Exit: {exit_price:.8f} | "
                    f"Shares: {position.shares:.4f} | "
                    f"PnL: {net_pnl:.4f} USDT | "
                    f"Fees: {position.entry_fee + position.exit_fee:.4f} USDT | "
                    f"Balance: {curr_balance:.2f} USDT"
                )

                exit_log_entry = {
                    'timestamp': position.exit_time,
                    'message': trade_log,
                    'type': 'exit',
                    'position_id': position.id,
                    'position_type': position.position_type,
                    'entry_price': position.entry_price,
                    'exit_price': exit_price,
                    'pnl': net_pnl,
                    'exit_reason': exit_reason
                }
                trade_log_global.append(exit_log_entry)

                positions_to_remove.append(position)
                logging.info(f"\n{'='*60}")
                logging.info(f"Position Closed: {position.position_type.upper()}")
                logging.info(f"Entry: {position.entry_price:.8f} | Exit: {exit_price:.8f}")
                logging.info(f"Net PnL: {net_pnl:.4f} USDT | Balance: {curr_balance:.2f} USDT")
                logging.info(f"{'='*60}")

        active_positions = [p for p in active_positions if p not in positions_to_remove]

def calculate_position_size(price):
    """FIXED: Returns the number of shares to buy based on full capital usage."""
    global current_balance
    # Use POSITION_SIZE_PCT of current balance
    usable_capital = current_balance * POSITION_SIZE_PCT
    # Apply leverage
    usable_capital *= LEVERAGE
    # How many shares we can afford
    shares = usable_capital / price
    # Ensure at least 1 share
    if shares < 1:
        shares = 1
    return shares

