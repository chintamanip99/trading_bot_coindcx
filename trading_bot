            df[feature] = 0

    return df[features].tail(1).copy(), features

def get_sarimax_prediction(df):
    global sarimax_model, sarimax_scaler_x, sarimax_scaler_y, sarimax_metadata

    if (sarimax_model is None or sarimax_scaler_x is None or
        sarimax_scaler_y is None or sarimax_metadata is None):
        return 0, 0.0, 0.0

    try:
        exog, feat = prepare_sarimax_features(df)

        feature_names = sarimax_metadata.get('feature_names', [])
        if not feature_names:
            feature_names = feat

        available_features = [f for f in feature_names if f in exog.columns]
        if len(available_features) != sarimax_scaler_x.n_features_in_:
            return 0, 0.0, 0.0

        exog = exog[available_features]
        exog_scaled = sarimax_scaler_x.transform(exog.values)

        forecast_scaled = sarimax_model.forecast(steps=1, exog=exog_scaled)

        if hasattr(forecast_scaled, 'values'):
            forecast_value = forecast_scaled.values[0]
        elif isinstance(forecast_scaled, (pd.Series, pd.DataFrame)):
            forecast_value = forecast_scaled.iloc[0]
        else:
            forecast_value = forecast_scaled

        predicted_diff = sarimax_scaler_y.inverse_transform(
            np.array(forecast_value).reshape(-1, 1)
        )[0][0]

        current_ema = df['ema'].iloc[-1]
        predicted_price = current_ema + (ALPHA * predicted_diff)
        current_price = df['close'].iloc[-1]
        price_diff = predicted_price - current_price

        price_change_pct = abs(price_diff) / current_price

        signal = 0
        confidence = 0.0

        min_movement_threshold = current_price * 0.0001

        if abs(price_diff) < min_movement_threshold:
            signal = 0
            confidence = 0.0

        elif price_diff > min_movement_threshold:
            signal = 1
            confidence = min(price_change_pct / 0.005, 0.8)

        elif price_diff < -min_movement_threshold:
            signal = 2
            confidence = min(price_change_pct / 0.005, 0.8)

        if signal != 0:
            price_ratio = predicted_price / current_price
            if price_ratio > 1.05 or price_ratio < 0.95:
                signal = 0
                confidence = 0.0

            if confidence > 0.95:
                confidence = 0.95

        return signal, confidence, predicted_price

    except Exception as e:
        logging.error(f"SARIMAX prediction error: {e}")
        return 0, 0.0, 0.0

def generate_combined_signal(df):
    global latest_signal_data

    lstm_signal, lstm_confidence, predicted_price_lstm, predicted_diff_lstm = get_lstm_prediction(df)
    cnn_signal, cnn_confidence, pattern_name = get_cnn_prediction(df)
    sarimax_signal, sarimax_confidence, predicted_price_sarimax = get_sarimax_prediction(df)

    current_price = df['close'].iloc[-1]

    current_rsi = df['rsi'].iloc[-1] if 'rsi' in df.columns else 0.0
    current_bb_position = df['bb_position'].iloc[-1] if 'bb_position' in df.columns else 0.0
    current_volume_ratio = df['volume_ratio'].iloc[-1] if 'volume_ratio' in df.columns else 0.0
    current_macd_hist = df['macd_hist'].iloc[-1] if 'macd_hist' in df.columns else 0.0

    MULTI_MODEL_THRESHOLD = 0.08

    valid_signals = []

    if lstm_signal != 0 and lstm_confidence >= MULTI_MODEL_THRESHOLD:
        valid_signals.append(('LSTM', lstm_signal, lstm_confidence))

    if cnn_signal != 0 and cnn_confidence >= MULTI_MODEL_THRESHOLD:
        valid_signals.append(('CNN_Research', cnn_signal, cnn_confidence))

    if sarimax_signal != 0 and sarimax_confidence >= MULTI_MODEL_THRESHOLD:
        valid_signals.append(('SARIMAX', sarimax_signal, sarimax_confidence))

    final_signal = 0
    final_confidence = 0.0
    consensus_achieved = False
    signal_reason = "No consensus"
    agreeing_models_count = 0

    logging.info(f"Valid signals count: {len(valid_signals)}")
    for name, sig, conf in valid_signals:
        logging.info(f"  {name}: signal={sig}, confidence={conf:.3f}")

    if len(valid_signals) >= 2:
        bullish_signals = [s for s in valid_signals if s[1] == 1]
        bearish_signals = [s for s in valid_signals if s[1] == 2]

        if len(bullish_signals) >= 2:
            final_signal = 1
            final_confidence = np.mean([s[2] for s in bullish_signals])
            model_names = [s[0] for s in bullish_signals]
            signal_reason = f"Multi-Model Bullish: {', '.join(model_names[:2])}"
            consensus_achieved = True
            agreeing_models_count = len(bullish_signals)

        elif len(bearish_signals) >= 2:
            final_signal = 2
            final_confidence = np.mean([s[2] for s in bearish_signals])
            model_names = [s[0] for s in bearish_signals]
            signal_reason = f"Multi-Model Bearish: {', '.join(model_names[:2])}"
            consensus_achieved = True
            agreeing_models_count = len(bearish_signals)

    if not consensus_achieved and len(valid_signals) > 0:
        strongest_model = max(valid_signals, key=lambda x: x[2])
        model_name, model_signal, model_confidence = strongest_model

        if model_confidence >= 0.15:
            final_signal = model_signal
            final_confidence = model_confidence
            signal_reason = f"Single Model: {model_name} ({model_confidence:.1%} confidence)"
            consensus_achieved = True
            agreeing_models_count = 1

    if not consensus_achieved and len(valid_signals) >= 2:
        all_signals_same = all(s[1] == valid_signals[0][1] for s in valid_signals)
        if all_signals_same:
            final_signal = valid_signals[0][1]
            final_confidence = np.mean([s[2] for s in valid_signals])
            model_names = [s[0] for s in valid_signals]
            signal_reason = f"Unanimous Direction: {', '.join(model_names)}"
            consensus_achieved = True
            agreeing_models_count = len(valid_signals)

    latest_signal_data = {
        'signal': final_signal,
        'confidence': final_confidence,
        'reason': signal_reason,
        'lstm_signal': lstm_signal,
        'lstm_confidence': lstm_confidence,
        'cnn_signal': cnn_signal,
        'cnn_confidence': cnn_confidence,
        'pattern': pattern_name,
        'sarimax_signal': sarimax_signal,
        'sarimax_confidence': sarimax_confidence,
        'consensus_achieved': consensus_achieved,
        'current_price': current_price,
        'rsi': current_rsi,
        'bb_position': current_bb_position,
        'volume_ratio': current_volume_ratio,
        'macd_hist': current_macd_hist,
        'valid_signals_count': len(valid_signals),
        'agreeing_models': agreeing_models_count
    }

    return latest_signal_data

def execute_trade(signal_data, current_price):
    global trade_log_global, current_balance, last_trade_time, active_positions, order_status

    signal = signal_data['signal']
    confidence = signal_data['confidence']
    reason = signal_data['reason']

    if not signal_data.get('consensus_achieved', False):
        logging.info(f"No trade: {reason}")
        return

    if last_trade_time and (datetime.datetime.now() - last_trade_time) < min_time_between_trades:
        return

    if order_status == 'open':
        logging.info("Order already pending - skipping new trade")
        return

    # ============================================================
    # FIXED: dynamically calculate shares from current balance
    # ============================================================
    shares = calculate_position_size(current_price)
    logging.info(f"Calculated position size: {shares:.4f} BIO "
                 f"(balance={current_balance:.2f} USDT, price={current_price:.8f}, "
                 f"pct={POSITION_SIZE_PCT}, leverage={LEVERAGE})")

    if shares <= 0:
        logging.info("Calculated shares <= 0, skipping trade")
        return

    if not can_open_new_position():
        logging.info("Cannot open new position - max positions reached")
        return

    if not is_valid_new_position("long" if signal == 1 else "short", current_price):
        logging.info("Invalid position - too close to existing position")
        return

    predicted_price = signal_data.get('current_price', current_price)
    predicted_diff = predicted_price - current_price

    position_type = "long" if signal == 1 else "short"

    new_position = TradePosition(
        position_type,
        current_price,
        shares,
        predicted_price - current_price,
        predicted_diff
    )

    with position_lock:
        active_count = sum(1 for position in active_positions if not position.exited)
        if active_count >= max_positions:
            logging.info("Max positions reached - cancelling trade execution")
            return

        active_positions.append(new_position)
        last_trade_time = datetime.datetime.now()

    trade_time = datetime.datetime.now()

    try:
        order_type = "buy" if signal == 1 else "sell"
        order_response = place_order(order_type, current_price, shares, new_position.id)

        if order_response is None and REAL_TRADING_MODE:
            logging.error("Failed to place order - removing position from active positions")
            with position_lock:
                if new_position in active_positions:
                    active_positions.remove(new_position)
            return
    except Exception as e:
        logging.error(f"Error placing order: {e}")
        with position_lock:
            if new_position in active_positions:
                active_positions.remove(new_position)
        return

    mode_indicator = "REAL" if REAL_TRADING_MODE else "PAPER"

    trade_log = (
        f"{mode_indicator} TRADE - {'LONG' if signal == 1 else 'SHORT'} opened at {current_price:.8f} | "
        f"Size: {shares:.4f} BIO (value={new_position.position_value:.2f} USDT) | "
        f"Confidence: {confidence:.2%} | "
        f"Target: {new_position.target:.8f} (+1%) | SL: {new_position.stop_loss:.8f} (-4%) | "
        f"Balance: {current_balance:.2f} USDT | Reason: {reason}"
    )

    trade_log_entry = {
        'timestamp': trade_time,
        'message': trade_log,
        'type': 'entry',
        'position_id': new_position.id,
        'position_type': 'long' if signal == 1 else 'short',
        'entry_price': current_price,
        'shares': shares,
        'predicted_diff': predicted_diff,
        'target_price': new_position.target,
        'stop_loss_price': new_position.stop_loss,
        'trading_mode': mode_indicator,
        'consensus_trade': True
    }
    trade_log_global.append(trade_log_entry)

    logging.info(f"\n{'='*80}")
    logging.info(f"TRADE EXECUTED ({mode_indicator} MODE)")
    logging.info(f"Signal: {'LONG' if signal == 1 else 'SHORT'}")
    logging.info(f"Shares: {shares:.4f}  |  Position Value: {new_position.position_value:.2f} USDT")
    logging.info(f"Entry Price: {current_price:.8f}")
    logging.info(f"Target: {new_position.target:.8f} (+1%) | Stop Loss: {new_position.stop_loss:.8f} (-4%)")
    logging.info(f"Balance After Entry: {current_balance:.2f} USDT")
    logging.info(f"Reason: {reason}")
    logging.info(f"{'='*80}")

