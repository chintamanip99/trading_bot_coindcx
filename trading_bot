def detect_candle_patterns_research_based(df):
    pattern_results = {}

    df['ma_5h'] = talib.SMA(df['close'], timeperiod=5)

    for pattern in MAIN_CANDLE_PATTERNS:
        try:
            pattern_func = getattr(talib, pattern)
            pattern_results[pattern] = pattern_func(df['open'], df['high'], df['low'], df['close'])
        except Exception as e:
            logging.warning(f"Error detecting pattern {pattern}: {e}")
            pattern_results[pattern] = np.zeros(len(df))

    return pattern_results, df

def create_pattern_labels_research_based(pattern_results, df):
    labels = []
    pattern_names = list(MAIN_CANDLE_PATTERNS)

    pattern_df = pd.DataFrame(pattern_results)

    for idx in range(len(pattern_df)):
        if idx < 5:
            labels.append('NO_PATTERN')
            continue

        row = pattern_df.iloc[idx]

        recent_closes = df['close'].iloc[idx-4:idx+1]
        ma_5h = df['ma_5h'].iloc[idx]

        closes_below_ma = (recent_closes < ma_5h).sum()
        trend = 'DOWN' if closes_below_ma >= 3 else 'UP'

        detected_patterns = []

        for pattern in pattern_names:
            pattern_value = row[pattern]

            if pattern_value != 0:
                if pattern == 'CDLENGULFING':
                    if pattern_value > 0:
                        detected_patterns.append('BULLISH_ENGULFING')
                    elif pattern_value < 0:
                        detected_patterns.append('BEARISH_ENGULFING')
                elif pattern == 'CDLHARAMI':
                    if pattern_value > 0:
                        detected_patterns.append('BULLISH_HARAMI')
                    elif pattern_value < 0:
                        detected_patterns.append('BEARISH_HARAMI')
                elif pattern == 'CDLHAMMER':
                    detected_patterns.append('HAMMER')
                elif pattern == 'CDLSHOOTINGSTAR':
                    detected_patterns.append('SHOOTING_STAR')
                else:
                    detected_patterns.append(pattern)

        if len(detected_patterns) == 0:
            labels.append('NO_PATTERN')
        elif len(detected_patterns) == 1:
            labels.append(detected_patterns[0])
        else:
            priority_order = [
                'BULLISH_ENGULFING', 'BEARISH_ENGULFING', 'BULLISH_HARAMI', 'BEARISH_HARAMI',
                'HAMMER', 'SHOOTING_STAR', 'CDLMORNINGSTAR', 'CDLDOJI'
            ]

            for priority_pattern in priority_order:
                if priority_pattern in detected_patterns:
                    labels.append(priority_pattern)
                    break

    return labels

def prepare_lstm_features(df):
    features = [
        'log_close', 'close_diff', 'rsi', 'mom',
        'ema_5', 'ema_10', 'ema_20', 'ema_50',
        'close_ema_5_ratio', 'close_ema_10_ratio',
        'close_ema_20_ratio', 'close_ema_50_ratio',
        'roc_5', 'roc_10', 'roc_15',
        'volatility_10', 'volatility_20'
    ]

    df = clean_data(df)

    for feature in features:
        if feature not in df.columns:
            logging.warning(f"Creating missing feature: {feature}")
            if feature in ['rsi', 'mom']:
                df[feature] = 50.0
            elif 'volatility' in feature:
                df[feature] = 0.0
            elif 'ratio' in feature:
                df[feature] = 1.0
            else:
                df[feature] = 0.0

    df_subset = df[features].tail(LOOKBACK)

    if len(df_subset) < LOOKBACK:
        logging.warning(f"Not enough data for LSTM: {len(df_subset)} < {LOOKBACK}")
        padding_rows = LOOKBACK - len(df_subset)
        first_row = df_subset.iloc[0:1]
        padding = pd.DataFrame([first_row.values[0]] * padding_rows, columns=df_subset.columns)
        df_subset = pd.concat([padding, df_subset], ignore_index=True)

    return df_subset.values, features

def get_lstm_prediction(df):
    global lstm_model, lstm_scaler, target_scaler, lstm_mae

    if lstm_model is None:
        return 0, 0.0, 0.0, 0.0

    if len(df) < LOOKBACK:
        return 0, 0.0, 0.0, 0.0

    try:
        lstm_X, feature_names = prepare_lstm_features(df)

        if not hasattr(lstm_scaler, 'scale_') or lstm_scaler.scale_ is None:
            return 0, 0.0, 0.0, 0.0

        if not hasattr(target_scaler, 'scale_') or target_scaler.scale_ is None:
            return 0, 0.0, 0.0, 0.0

        try:
            scaled_data = lstm_scaler.transform(lstm_X)
        except ValueError as e:
            logging.error(f"Error scaling LSTM data: {e}")
            return 0, 0.0, 0.0, 0.0

        lstm_input = scaled_data.reshape((1, LOOKBACK, len(feature_names)))

        predicted_diff_scaled = lstm_model.predict(lstm_input, verbose=0)
        predicted_diff = target_scaler.inverse_transform(predicted_diff_scaled)[0][0]

        current_ema = df['ema'].iloc[-1]
        predicted_price = current_ema + (ALPHA * predicted_diff)
        current_price = df['close'].iloc[-1]
        price_diff = predicted_price - current_price

        price_change_pct = abs(price_diff) / current_price

        signal = 0
        confidence = 0.0

        if price_diff > current_price * 0.0002:
            signal = 1
            base_confidence = min(price_change_pct / 0.002, 1.0)

            if base_confidence > 0.05:
                momentum = df['mom'].iloc[-1] if 'mom' in df.columns else 0
                if momentum > 0:
                    momentum_boost = min(momentum / 20.0, 0.2)
                    confidence = min(base_confidence + momentum_boost, 1.0)
                else:
                    confidence = base_confidence * 0.8
            else:
                confidence = base_confidence

        elif price_diff < -current_price * 0.0002:
            signal = 2
            base_confidence = min(price_change_pct / 0.002, 1.0)

            if base_confidence > 0.05:
                momentum = df['mom'].iloc[-1] if 'mom' in df.columns else 0
                if momentum < 0:
                    momentum_boost = min(abs(momentum) / 20.0, 0.2)
                    confidence = min(base_confidence + momentum_boost, 1.0)
                else:
                    confidence = base_confidence * 0.8
            else:
                confidence = base_confidence

        if signal != 0:
            if confidence < 0.08:
                signal = 0
                confidence = 0.0
            elif confidence < 0.12:
                confidence = 0.12

        logging.info(f"LSTM Prediction: signal={signal}, confidence={confidence:.3f}, "
                    f"price_diff={price_diff:.6f}, price_change_pct={price_change_pct:.4%}, "
                    f"predicted_diff={predicted_diff:.8f}")

        return signal, confidence, predicted_price, predicted_diff

    except Exception as e:
        logging.error(f"LSTM prediction error: {e}")
        import traceback
        logging.error(traceback.format_exc())
        return 0, 0.0, 0.0, 0.0

def create_gaf_images_research_method(data, columns, window_size, method='difference'):
    gaf = GramianAngularField(method=method, image_size=window_size)

    if len(data) < window_size:
        return None

    try:
        window_data = data[columns].tail(window_size).values.T.astype(np.float64)
        gaf_image = gaf.fit_transform(window_data)
        return gaf_image
    except Exception as e:
        logging.error(f"Error creating GAF image: {e}")
        return None

