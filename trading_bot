def fetch_initial_data():
    end_time = int(datetime.datetime.now().timestamp() * 1000)
    start_time = int((datetime.datetime.now() - timedelta(days=365)).timestamp() * 1000)
    url = f"https://public.coindcx.com/market_data/candles?pair=B-LAB_USDT&interval=1m&startTime={start_time}&endTime={end_time}"
    try:
        response = requests.get(url)
        data = response.json()
        df = pd.DataFrame(data).rename(columns={
            'open': 'open', 'high': 'high', 'low': 'low',
            'volume': 'volume', 'close': 'close'
        })
        df['time'] = pd.to_datetime(df['time'], unit='ms')
        df[['open', 'high', 'low', 'close', 'volume']] = df[['open', 'high', 'low', 'close', 'volume']].astype(float)

        df = calculate_all_features(df)
        return df
    except Exception as e:
        logging.error(f"Error fetching initial data: {e}")
        return None

def calculate_all_features(df):
    df['log_close'] = np.log(df['close'])
    df['close_diff'] = df['close'].diff()
    df['price_range'] = df['high'] - df['low']
    df['body_size'] = abs(df['close'] - df['open'])
    df['upper_shadow'] = df['high'] - np.maximum(df['open'], df['close'])
    df['lower_shadow'] = np.minimum(df['open'], df['close']) - df['low']

    df['real_body'] = abs(df['close'] - df['open'])

    df['rsi'] = talib.RSI(df['close'], timeperiod=14)
    df['mom'] = talib.MOM(df['close'], timeperiod=10)
    df['cci'] = talib.CCI(df['high'], df['low'], df['close'], timeperiod=14)

    df['slowk'], df['slowd'] = talib.STOCH(
        df['high'], df['low'], df['close'],
        fastk_period=14, slowk_period=3, slowd_period=3
    )

    df['macd'], df['macd_signal'], df['macd_hist'] = talib.MACD(
        df['close'], fastperiod=12, slowperiod=26, signalperiod=9
    )

    df['ema_5'] = talib.EMA(df['close'], timeperiod=5)
    df['ema_10'] = talib.EMA(df['close'], timeperiod=10)
    df['ema_12'] = talib.EMA(df['close'], timeperiod=12)
    df['ema_20'] = talib.EMA(df['close'], timeperiod=20)
    df['ema_26'] = talib.EMA(df['close'], timeperiod=26)
    df['ema_50'] = talib.EMA(df['close'], timeperiod=50)
    df['sma_10'] = talib.SMA(df['close'], timeperiod=10)
    df['sma_20'] = talib.SMA(df['close'], timeperiod=20)

    df['ma_5h'] = talib.SMA(df['close'], timeperiod=5)

    df['close_ema_5_ratio'] = df['close'] / df['ema_5']
    df['close_ema_10_ratio'] = df['close'] / df['ema_10']
    df['close_ema_20_ratio'] = df['close'] / df['ema_20']
    df['close_ema_50_ratio'] = df['close'] / df['ema_50']

    df['ema_5_10_cross'] = df['ema_5'] - df['ema_10']
    df['ema_10_20_cross'] = df['ema_10'] - df['ema_20']

    df['roc_5'] = talib.ROC(df['close'], timeperiod=5)
    df['roc_10'] = talib.ROC(df['close'], timeperiod=10)
    df['roc_15'] = talib.ROC(df['close'], timeperiod=15)

    df['bb_upper'], df['bb_middle'], df['bb_lower'] = talib.BBANDS(
        df['close'], timeperiod=20, nbdevup=2, nbdevdn=2
    )
    df['bb_width'] = (df['bb_upper'] - df['bb_lower']) / df['bb_middle']
    df['bb_position'] = (df['close'] - df['bb_lower']) / (df['bb_upper'] - df['bb_lower'])

    df['volume_sma'] = talib.SMA(df['volume'], timeperiod=20)
    df['volume_ratio'] = df['volume'] / df['volume_sma']

    df['returns'] = df['close'].pct_change()
    df['volatility_10'] = df['returns'].rolling(10, min_periods=1).std()
    df['volatility_20'] = df['returns'].rolling(20, min_periods=1).std()
    df['volatility'] = df['returns'].rolling(20, min_periods=1).std()
    df['atr'] = talib.ATR(df['high'], df['low'], df['close'], timeperiod=14)

    df['adx'] = talib.ADX(df['high'], df['low'], df['close'], timeperiod=14)
    df['plus_di'] = talib.PLUS_DI(df['high'], df['low'], df['close'], timeperiod=14)
    df['minus_di'] = talib.MINUS_DI(df['high'], df['low'], df['close'], timeperiod=14)

    df['ema'] = talib.EMA(df['close'], timeperiod=EMA_PERIOD)
    df['current_ema'] = talib.EMA(df['close'], timeperiod=EMA_PERIOD)

    df = clean_data(df)
    return df

def predict(df):
    global current_status, last_price, full_data, active_positions, latest_signal_data

    try:
        df = df.copy()
        df = calculate_all_features(df)
        full_data = df.to_dict('records')

        current_price = df['close'].iloc[-1]
        last_price = current_price

        if len(df) < LOOKBACK:
            current_status = f"Collecting data... {len(df)}/{LOOKBACK} required"
            update_status_display(current_status)
            return

        check_positions(current_price)

        signal_data = generate_combined_signal(df)

        if signal_data['signal'] in [1, 2] and signal_data['consensus_achieved']:
            logging.info(f"CONSENSUS ACHIEVED - Executing trade: {signal_data['reason']}")
            execute_trade(signal_data, current_price)

        mode_indicator = "REAL" if REAL_TRADING_MODE else "PAPER"
        consensus_status = "CONSENSUS ACHIEVED" if signal_data['consensus_achieved'] else "NO CONSENSUS"
        current_status = (
            f"Price: {current_price:.6f} | "
            f"LSTM: Signal={signal_data['lstm_signal']}, Conf={signal_data['lstm_confidence']:.2%} | "
            f"CNN_Research: Signal={signal_data['cnn_signal']}, Conf={signal_data['cnn_confidence']:.2%}, Pattern={signal_data['pattern']} | "
            f"SARIMAX: Signal={signal_data.get('sarimax_signal', 0)}, Conf={signal_data.get('sarimax_confidence', 0.0):.2%} | "
            f"Consensus: {consensus_status} | "
            f"Signal: {signal_data['signal']} | Conf: {signal_data['confidence']:.2%} | "
            f"RSI: {signal_data['rsi']:.1f} | BB: {signal_data['bb_position']:.2f} | "
            f"Vol: {signal_data['volume_ratio']:.2f} | MACD: {signal_data['macd_hist']:.6f} | "
            f"Positions: {len([p for p in active_positions if not p.exited])}/{max_positions} | "
            f"Balance: {current_balance:.2f} | PnL: {total_pnl:.2f} | "
            f"Order Status: {order_status} | "
