        pattern_labels = create_pattern_labels_research_based(pattern_results, df_enhanced)
        current_pattern = pattern_labels[-1] if pattern_labels else 'NO_PATTERN'

        signal = 0
        confidence = 0.0

        strong_bullish = ['BULLISH_ENGULFING', 'CDLMORNINGSTAR']
        strong_bearish = ['BEARISH_ENGULFING']

        medium_bullish = ['BULLISH_HARAMI', 'HAMMER']
        medium_bearish = ['BEARISH_HARAMI', 'SHOOTING_STAR']

        if current_pattern in strong_bullish:
            signal = 1
            confidence = 0.55
        elif current_pattern in strong_bearish:
            signal = 2
            confidence = 0.55
        elif current_pattern in medium_bullish:
            signal = 1
            confidence = 0.35
        elif current_pattern in medium_bearish:
