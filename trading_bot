            if recent_trend > 0.001:
                signal = 2
                confidence = 0.25
            elif recent_trend < -0.001:
                signal = 1
                confidence = 0.25
        else:
            signal = 0
            confidence = 0.1

        return signal, confidence, current_pattern

    except Exception as e:
