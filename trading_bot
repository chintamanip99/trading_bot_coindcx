def clean_data(df):
    df.replace([np.inf, -np.inf], np.nan, inplace=True)
    df.fillna(method='ffill', inplace=True)
    df.fillna(method='bfill', inplace=True)
    df.fillna(0, inplace=True)
    return df

def calculate_candlestick_features_research(df):
    df['real_body'] = abs(df['close'] - df['open'])
    df['upper_shadow'] = df['high'] - np.maximum(df['open'], df['close'])
    df['lower_shadow'] = np.minimum(df['open'], df['close']) - df['low']
    return df

def initialize_scalers(df):
    global lstm_scaler, cnn_scaler, target_scaler, culr_scaler

    lstm_features = [
        'log_close', 'close_diff', 'rsi', 'mom',
        'ema_5', 'ema_10', 'ema_20', 'ema_50',
        'close_ema_5_ratio', 'close_ema_10_ratio',
        'close_ema_20_ratio', 'close_ema_50_ratio',
        'roc_5', 'roc_10', 'roc_15',
        'volatility_10', 'volatility_20'
    ]

    culr_features = ['close', 'upper_shadow', 'lower_shadow', 'real_body']

    df = clean_data(df)
    if len(df) > 0:
        for feature in lstm_features:
            if feature not in df.columns:
                if feature in ['rsi', 'mom']:
                    df[feature] = 50.0
                elif 'volatility' in feature:
                    df[feature] = 0.0
                elif 'ratio' in feature:
                    df[feature] = 1.0
                else:
                    df[feature] = 0.0

        lstm_scaler.fit(df[lstm_features].values)
        logging.info(f"LSTM scaler fitted with {len(lstm_features)} features")

        culr_scaler = MinMaxScaler(feature_range=(0, 1))
        if all(col in df.columns for col in culr_features):
            culr_scaler.fit(df[culr_features].values)
            logging.info("CULR scaler fitted successfully")

        df['ema'] = talib.EMA(df['close'], timeperiod=EMA_PERIOD)
        ema_shifted = df['ema'].shift(-TARGET_LOOKAHEAD)
        valid_indices = ~ema_shifted.isna()
        if np.sum(valid_indices) > 0:
            predicted_diff = (ema_shifted[valid_indices] - df['ema'][valid_indices]) / ALPHA
            target_scaler.fit(predicted_diff.values.reshape(-1, 1))
            logging.info("Target scaler fitted successfully")

        legacy_cnn_features = [
            'log_close', 'close_diff', 'price_range', 'body_size', 'upper_shadow', 'lower_shadow',
            'rsi', 'mom', 'stoch_k', 'stoch_d', 'sma_10', 'sma_20', 'ema_12', 'ema_26',
            'macd', 'macd_signal', 'macd_hist', 'bb_upper', 'bb_middle', 'bb_lower',
            'bb_width', 'bb_position', 'volume_ratio', 'atr', 'volatility'
        ]
        if all(col in df.columns for col in legacy_cnn_features):
            cnn_scaler.fit(df[legacy_cnn_features].values)
            logging.info("CNN scaler fitted successfully")

