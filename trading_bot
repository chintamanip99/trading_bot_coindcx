class TradePosition:
    def __init__(self, position_type, entry_price, shares, predicted_move, predicted_diff):
        self.id = str(uuid.uuid4())
        self.position_type = position_type.lower()
        self.entry_price = float(entry_price)
        self.shares = float(shares)
        self.entry_time = datetime.datetime.now()
        self.exited = False
        self.position_value = self.entry_price * self.shares
        self.entry_fee = self.position_value * TAKER_FEE
        self.exit_fee = 0.0
        self.pnl = 0.0
        self.order_filled = False
        self.order_id = None
        self.predicted_diff = predicted_diff
        self.set_stop_target()

        # FIXED: Deduct the FULL position value + entry fee so balance
        #       reflects actual capital usage. When the position closes,
        #       we return the position value + net PnL.
        global current_balance, total_fees
        current_balance -= self.position_value
        current_balance -= self.entry_fee
        total_fees += self.entry_fee

    def set_stop_target(self):
        """Target = 1% | Stop Loss = 4%"""
        target_move = self.entry_price * 0.01      # 1%
        stop_loss_move = self.entry_price * 0.04   # 4%

        if self.position_type == "long":
            self.target = round(self.entry_price + target_move, 8)
            self.stop_loss = round(self.entry_price - stop_loss_move, 8)
        else:
            self.target = round(self.entry_price - target_move, 8)
            self.stop_loss = round(self.entry_price + stop_loss_move, 8)

        target_percentage = abs(self.target - self.entry_price) / self.entry_price * 100
        stop_loss_percentage = abs(self.stop_loss - self.entry_price) / self.entry_price * 100

        logging.info(f"Position {self.id}: Entry={self.entry_price:.6f}, "
                    f"Target={self.target:.6f} ({target_percentage:.2f}%), "
                    f"StopLoss={self.stop_loss:.6f} ({stop_loss_percentage:.2f}%)")

