# WebSocket handling
last_minute = None
data_lock = threading.Lock()
current_candle = None

def start_websocket():
    socketEndpoint = 'wss://stream.coindcx.com'
    sio = socketio.Client()
    global full_data, last_price, current_pengu_price, last_minute, current_candle

    current_candle = None
    last_minute = None

    @sio.event
    def connect():
        logging.info("Connected to CoinDCX WebSocket!")
        sio.emit('join', {'channelName': "B-LAB_USDT_1m-futures"})

    @sio.on('candlestick')
    def on_message(response):
        global full_data, last_price, current_pengu_price, last_minute, current_candle

        try:
            if isinstance(response.get('data'), str):
                response_data = json.loads(response['data'])
                candle_data = response_data.get('data', [{}])[0]
            else:
                candle_data = response.get('data', [{}])[0]

            new_price = float(candle_data.get("close", 0))
            open_price = float(candle_data.get("open", 0))
            high_price = float(candle_data.get("high", 0))
            low_price = float(candle_data.get("low", 0))
            volume = float(candle_data.get("volume", 0))
            open_time = int(candle_data.get("open_time", 0))

            if new_price == 0:
                return

            last_price = new_price
            current_pengu_price = new_price

            current_time = datetime.datetime.fromtimestamp(open_time)
            current_minute = current_time.minute

            candle_completed = False

            if last_minute is not None and current_minute != last_minute:
                if current_candle is not None:
                    full_data.append(current_candle)
                    logging.info(f"Completed candle: O:{current_candle['open']:.6f} "
                               f"H:{current_candle['high']:.6f} L:{current_candle['low']:.6f} "
                               f"C:{current_candle['close']:.6f}")
                    candle_completed = True

                if len(full_data) > LOOKBACK * 2:
                    full_data = full_data[-LOOKBACK * 2:]

                current_candle = {
                    'open': open_price,
                    'high': high_price,
                    'low': low_price,
                    'close': new_price,
                    'volume': volume,
                    'time': current_time
                }
                logging.info(f"New candle started: O:{open_price:.6f} H:{high_price:.6f} "
                           f"L:{low_price:.6f} C:{new_price:.6f}")

            elif current_candle is None:
                current_candle = {
                    'open': open_price,
                    'high': high_price,
                    'low': low_price,
                    'close': new_price,
                    'volume': volume,
                    'time': current_time
                }
                logging.info(f"First candle initialized: O:{open_price:.6f} H:{high_price:.6f} "
                           f"L:{low_price:.6f} C:{new_price:.6f}")
            else:
                current_candle['high'] = max(current_candle['high'], high_price)
                current_candle['low'] = min(current_candle['low'], low_price)
                current_candle['close'] = new_price
                current_candle['volume'] = volume

            if len(full_data) >= LOOKBACK - 1:
                prediction_data = full_data[-(LOOKBACK - 1):] + [current_candle]
                df = pd.DataFrame(prediction_data)
                predict(df)
            elif len(full_data) > 0:
                prediction_data = full_data + [current_candle]
                df = pd.DataFrame(prediction_data)
                predict(df)

            last_minute = current_minute

        except Exception as e:
            logging.error(f"WebSocket error: {str(e)}")

    @sio.event
    def disconnect():
        logging.info("Disconnected from WebSocket")

    try:
        sio.connect(socketEndpoint, transports=['websocket'])
        logging.info("WebSocket running...")
        sio.wait()
    except Exception as e:
        logging.error(f"WebSocket connection failed: {str(e)}")
    finally:
        sio.disconnect()

